typestate StackProtocol {
    Empty = {
        void push(int): NonEmpty,
        drop: end
    }
    NonEmpty = {
        void push(int): NonEmpty,
        int pop(): Unknown,
        drop:end
    }
    Unknown = {
        void push(int): NonEmpty,
        boolean isEmpty(): <true: Empty, false: NonEmpty>,
        drop:end
    }
}